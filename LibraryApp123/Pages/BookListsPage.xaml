<Page x:Class="libraryapp.Pages.BookListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки" Loaded="Page_Loaded"
      Style="{StaticResource PageRoot}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Мои списки" FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="Заброшенное, планы, процесс чтения и прочитанное — в одном месте." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,0,0,12" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Заброшено" Tag="0"/>
            <TabItem Header="В планах" Tag="1"/>
            <TabItem Header="Читаю" Tag="2"/>
            <TabItem Header="Прочитано" Tag="3"/>
        </TabControl>

        <DockPanel Grid.Row="2">
            <Border DockPanel.Dock="Top" Background="#F8FAFC" CornerRadius="12" Padding="12,10" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <WrapPanel>
                    <TextBox x:Name="SearchBox" Width="240" Height="36" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="SortBox" Width="200" Height="36" Margin="10,0,0,0" VerticalContentAlignment="Center" SelectionChanged="SortOrGenre_Changed">
                        <ComboBoxItem Content="Сортировка: название" Tag="title" IsSelected="True"/>
                        <ComboBoxItem Content="Сортировка: оценка" Tag="rating"/>
                    </ComboBox>
                    <ComboBox x:Name="GenreBox" Width="200" Height="36" Margin="10,0,0,0" VerticalContentAlignment="Center" SelectionChanged="SortOrGenre_Changed"/>
                    <Button Content="Обновить" Style="{StaticResource PrimaryActionButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="ReloadClick"/>
                </WrapPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BooksHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Page>
