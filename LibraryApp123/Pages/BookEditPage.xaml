<Page x:Class="libraryapp.Pages.BookEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга" Loaded="Page_Loaded"
      Style="{StaticResource PageRoot}">
    <ScrollViewer Padding="20,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" x:Name="FormRoot">
            <TextBlock x:Name="TitleHeader" FontSize="26" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="FTitle" Height="36"/>
            <TextBlock Text="Краткое описание" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <TextBox x:Name="FDescription" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"/>
            <TextBlock Text="Текст книги (для чтения)" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <TextBox x:Name="FFull" MinHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Жанры" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <ItemsControl x:Name="GenreList" Margin="0,4,0,8"/>
            <Button Content="Загрузить обложку" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="PickCover_Click"/>
            <TextBlock x:Name="CoverInfo" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button Content="Сохранить" Style="{StaticResource PrimaryActionButton}" Click="Save_Click"/>
                <Button Content="Отмена" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
