<Page x:Class="libraryapp.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог" Loaded="Page_Loaded"
      Style="{StaticResource PageRoot}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Каталог книг" FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="Найдите книгу, отфильтруйте по жанру и добавьте в свой список чтения." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="1">
            <Border DockPanel.Dock="Top" Background="#F8FAFC" CornerRadius="12" Padding="12,10" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <WrapPanel>
                    <TextBox x:Name="SearchBox" Width="240" Height="36" VerticalContentAlignment="Center" ToolTip="Поиск по названию или автору"/>
                    <ComboBox x:Name="SortBox" Width="200" Height="36" Margin="10,0,0,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Сортировка: название" Tag="title" IsSelected="True"/>
                        <ComboBoxItem Content="Сортировка: оценка" Tag="rating"/>
                    </ComboBox>
                    <ComboBox x:Name="GenreBox" Width="200" Height="36" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
                    <Button Content="Обновить" Style="{StaticResource PrimaryActionButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="Refresh_Click"/>
                </WrapPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BooksHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Page>
