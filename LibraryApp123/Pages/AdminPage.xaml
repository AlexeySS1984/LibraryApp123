<Page x:Class="libraryapp.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование" Loaded="Page_Loaded"
      Style="{StaticResource PageRoot}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Администрирование" FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="Жалобы, оспаривания, заявки авторов и заморозки." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem Header="Жалобы" x:Name="TabComplaints"/>
            <TabItem Header="Оспаривания заморозки" x:Name="TabDisputes"/>
            <TabItem Header="Заявки на роль автора" x:Name="TabAuthorReq"/>
            <TabItem Header="Замороженные" x:Name="TabFrozen"/>
            <TabItem Header="Пользователи" x:Name="TabUsers"/>
        </TabControl>
    </Grid>
</Page>
