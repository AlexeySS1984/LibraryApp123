<Window x:Class="libraryapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <DockPanel>
        <Border x:Name="FreezeBanner" DockPanel.Dock="Top" Background="#7F1D1D" Padding="12,10" Visibility="Collapsed">
            <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="13"
                       Text="Ваш аккаунт заморожен. Некоторые действия могут быть ограничены. Подробности — в разделе «Профиль»."/>
        </Border>

        <!-- Сайдбар -->
        <Border DockPanel.Dock="Left" Width="240">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="БИБЛИОТЕКА" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>

                    <TextBlock Text="Мой каталог" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
                    <Button x:Name="BtnLogout" Style="{StaticResource SidebarIconButton}" Click="NavLogout">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Fill="White" Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5ZM4,5h8V3H4c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h8v-2H4V5z"/>
                            </Viewbox>
                            <TextBlock Text="Выход" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="#334155" Margin="0,4"/>
                    <Button Style="{StaticResource SidebarIconButton}" Click="NavProfile">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Fill="White" Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"/>
                            </Viewbox>
                            <TextBlock Text="Профиль" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SidebarIconButton}" Click="NavCatalog">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Path Fill="White" Data="M4,2 L20,2 20,22 4,22 Z M6,6 L18,6 M6,10 L14,10"/>
                                </Viewbox>
                                <TextBlock Text="Каталог" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarIconButton}" Click="NavLists">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Path Fill="White" Data="M3,4 H21 V8 H3 Z M3,10 H21 V14 H3 Z M3,16 H21 V20 H3 Z"/>
                                </Viewbox>
                                <TextBlock Text="Мои списки" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAdmin" Style="{StaticResource SidebarIconButton}" Click="NavAdmin" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Path Fill="White" Data="M12,1 L3,5 V11 C3,16.55 6.84,21.74 12,23 17.16,21.74 21,16.55 21,11 V5 Z"/>
                                </Viewbox>
                                <TextBlock Text="Администрирование" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAuthor" Style="{StaticResource SidebarIconButton}" Click="NavAuthor" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                    <Path Fill="White" Data="M3,17.25 V21 H21 V17.25 C21,15.45 16,14 12,14 8,14 3,15.45 3,17.25 M12,12 A4,4 0 1,0 12,4 A4,4 0 1,0 12,12 Z"/>
                                </Viewbox>
                                <TextBlock Text="Кабинет автора" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Background="{StaticResource CanvasBrush}" Padding="20,16,24,20">
            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.06" Direction="270" Color="#1E293B"/>
                </Border.Effect>
                <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" Navigated="RootFrame_Navigated" Margin="3"/>
            </Border>
        </Border>
    </DockPanel>
</Window>
