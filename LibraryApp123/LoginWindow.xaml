<Window x:Class="libraryapp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Читальня" Height="480" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A">
    <Border Padding="28">
        <Border CornerRadius="20" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="0.5"/>
                    <GradientStop Color="#1A1033" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="28,28,28,8">
                    <TextBlock Text="ЧИТАЛЬНЯ" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Добро пожаловать" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="Войдите или создайте аккаунт, чтобы открыть каталог и свои списки чтения." Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="16,0,16,20" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <TabControl Margin="12,0,12,0" Background="Transparent">
                        <TabItem Header="Вход">
                            <StackPanel Margin="8,16,8,8" VerticalAlignment="Center">
                                <TextBlock Text="Логин" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,0" FontWeight="SemiBold"/>
                                <TextBox x:Name="LoginLogin" Height="36"/>
                                <TextBlock Text="Пароль" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,6" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="LoginPassword" Height="36"/>
                                <Button Content="Войти" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,0" Click="DoLogin"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Регистрация">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                <StackPanel Margin="8,12,8,8">
                                    <TextBlock Text="Логин" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <TextBox x:Name="RegLogin" Height="34"/>
                                    <TextBlock Text="Пароль" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,6" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="RegPassword" Height="34"/>
                                    <TextBlock Text="Электронная почта" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,6" FontWeight="SemiBold"/>
                                    <TextBox x:Name="RegEmail" Height="34"/>
                                    <TextBlock Text="Отображаемое имя" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,6" FontWeight="SemiBold"/>
                                    <TextBox x:Name="RegName" Height="34"/>
                                    <Button Content="Создать аккаунт" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Margin="0,18,0,8" Click="DoRegister"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
