<Window x:Class="libraryapp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Читальня" Height="600" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}">
    <Border Padding="32">
        <Border CornerRadius="16" ClipToBounds="True" Background="{StaticResource CardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.12" Direction="270" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="32,32,32,24">
                    <TextBlock Text="📚 ЧИТАЛЬНЯ" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Добро пожаловать" Foreground="{StaticResource InkBrush}" FontSize="28" FontWeight="Bold" Margin="0,12,0,0"/>
                    <TextBlock Text="Войдите или создайте аккаунт, чтобы открыть каталог и свои списки чтения." 
                               Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0">
                    <TabControl x:Name="TabControl" Margin="0" Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged">
                        <TabItem Header="Вход" Padding="12,8" Margin="0,0,0,0">
                            <StackPanel Margin="32,32,32,32" VerticalAlignment="Top">
                                <TextBlock Text="Логин" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"/>
                                <TextBox x:Name="LoginLogin" Height="40" Margin="0,0,0,20" FontSize="13"/>

                                <TextBlock Text="Пароль" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"/>
                                <PasswordBox x:Name="LoginPassword" Height="40" Margin="0,0,0,28" FontSize="13"/>

                                <Button Content="🚀 Войти" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Height="44" FontSize="14" FontWeight="SemiBold" Click="DoLogin"/>

                                <TextBlock Margin="0,16,0,0" TextAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                    <Run>Нет аккаунта? </Run>
                                    <Hyperlink x:Name="LinkToRegister" Foreground="{StaticResource BrandAccentBrush}" TextDecorations="None" RequestNavigate="LinkToRegister_Click">зарегистрируйтесь</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Регистрация" Padding="12,8" Margin="0,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="32,32,32,32">
                                    <TextBlock Text="Логин" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBox x:Name="RegLogin" Height="40" Margin="0,0,0,16" FontSize="13"/>

                                    <TextBlock Text="Электронная почта" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBox x:Name="RegEmail" Height="40" Margin="0,0,0,16" FontSize="13"/>

                                    <TextBlock Text="Отображаемое имя" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBox x:Name="RegName" Height="40" Margin="0,0,0,16" FontSize="13"/>

                                    <TextBlock Text="Пароль" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="12"/>
                                    <PasswordBox x:Name="RegPassword" Height="40" Margin="0,0,0,24" FontSize="13"/>

                                    <Button Content="✍️ Создать аккаунт" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Height="44" FontSize="14" FontWeight="SemiBold" Click="DoRegister"/>

                                    <TextBlock Margin="0,16,0,0" TextAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                        <Run>Уже есть аккаунт? </Run>
                                        <Hyperlink x:Name="LinkToLogin" Foreground="{StaticResource BrandAccentBrush}" TextDecorations="None" RequestNavigate="LinkToLogin_Click" NavigateUri="LoginWindow.xaml">войдите</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
